<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_img"
    tools:context=".SelectedServices">

    <!-- Header -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:gravity="center"
        android:padding="16dp"
        android:text="BookService"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Selected Services Title -->
    <TextView
        android:id="@+id/selected_services_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Selected Services"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Service List -->
    <TextView
        android:id="@+id/service_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Service 1\nService 2"
        android:textColor="#EEEEEE"
        android:textSize="16sp"
        android:background="@drawable/input_background1"
        app:layout_constraintTop_toBottomOf="@id/selected_services_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"/>

    <!-- Grand Total -->
    <TextView
        android:id="@+id/grand_total"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Grand Total: $0"
        android:textColor="#FFEB3B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/service_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Date & Time Label -->
    <TextView
        android:id="@+id/date_time_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select Date and Time"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/grand_total"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Date Picker -->
    <EditText
        android:id="@+id/date_picker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="📅 Select Date"
        android:background="@drawable/input_background1"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC"
        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
        android:padding="14dp"
        android:focusable="false"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/date_time_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"/>

    <!-- Time Picker -->
    <EditText
        android:id="@+id/time_picker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="⏰ Select Time"
        android:background="@drawable/input_background1"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC"
        android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
        android:padding="14dp"
        android:focusable="false"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/date_picker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"/>

    <!-- Repeat Label -->
    <TextView
        android:id="@+id/repeat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/time_picker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Repeat Options -->
    <RadioGroup
        android:id="@+id/repeat_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/repeat_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/repeat_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button"
            android:button="@null"
            android:text="Daily"
            android:padding="10dp"
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:elevation="2dp" />

        <RadioButton
            android:id="@+id/repeat_weekly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button"
            android:button="@null"
            android:text="Weekly"
            android:padding="10dp"
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:elevation="2dp" />

        <RadioButton
            android:id="@+id/repeat_once"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button"
            android:button="@null"
            android:text="Once"
            android:padding="10dp"
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:elevation="2dp" />
    </RadioGroup>


    <!-- Proceed Button -->
    <Button
        android:id="@+id/proceed_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proceed"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/proceed_button_background"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="14dp"
        android:elevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/repeat_options"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
